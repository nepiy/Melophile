{
  "name": "melophile-records",
  "version": "1.0.0",
  "private": true,
  "description": "Melophile Records — independent label and recording studio. Public site + content admin.",
  "scripts": {
    "dev": "node scripts/dev-with-admin.mjs",
    "prebuild": "npm run db:migrate",
    "build": "opennextjs-cloudflare build",
    "build:next": "npm run db:migrate && next build",
    "build:cloudflare": "opennextjs-cloudflare build",
    "preview:cloudflare": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy:cloudflare": "opennextjs-cloudflare deploy",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "start": "npm run db:migrate && next start",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:reset": "rm -f data/melophile.db && npm run db:migrate && npm run db:seed",
    "setup": "npm run db:migrate && npm run db:seed",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"*.{ts,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\"",
    "check": "tsx --tsconfig scripts/tsconfig.json scripts/check-content.ts",
    "admin": "node scripts/admin-server.mjs",
    "dev:admin": "node scripts/dev-with-admin.mjs",
    "admin:password": "tsx --tsconfig scripts/tsconfig.json scripts/reset-password.ts",
    "dev:site": "next dev",
    "art:regen": "tsx --tsconfig scripts/tsconfig.json scripts/regen-art.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.110.8",
    "better-sqlite3": "^13.0.1",
    "drizzle-orm": "^0.45.2",
    "next": "^15.5.22",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "server-only": "^0.0.1",
    "sharp": "^0.35.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "drizzle-kit": "^0.31.10",
    "prettier": "^3.9.6",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "wrangler": "^4.120.0"
  },
  "overrides": {
    "postcss": "^8.5.23",
    "sharp": "^0.35.3",
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.12"
    }
  },
  "engines": {
    "node": "22.x"
  }
}
