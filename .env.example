# Copy to .env.local and fill in. Nothing here is required to run the site locally
# except SESSION_SECRET, which the setup script will refuse to run without.

# --- required ---
# 32+ random bytes. Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# --- the first admin login, created by `npm run db:seed` ---
ADMIN_EMAIL=studio@melophilerecords.test
ADMIN_PASSWORD=change-this-on-first-login

# --- optional ---
# Where the SQLite file lives. Default: ./data/melophile.db
DATABASE_URL=file:./data/melophile.db

# The admin's own address (npm run admin). Default 4100.
# If you change it, it is picked up by next.config.ts too — server actions check
# the request Origin against this port, so the two must agree.
ADMIN_PORT=4100

# Booking notifications. Leave blank and bookings still save — they are written to
# data/outbox/ instead and flagged "not notified" in the admin, never silently dropped.
RESEND_API_KEY=
BOOKING_NOTIFY_TO=bookings@melophilerecords.test
BOOKING_NOTIFY_FROM=site@melophilerecords.test

# --- payments (the store) ---
# Leave blank and the store still works: orders are recorded and appear in the
# admin, and the customer is told plainly that payment will be arranged
# directly. Paste a key and checkout redirects to Stripe's own hosted page, so
# no card details ever touch this server.
STRIPE_SECRET_KEY=

# Used in canonical URLs and the sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- customer accounts (Supabase) ---
# Leave these blank and the site works exactly as before: the shop, catalogue
# and admin do not use Supabase at all, and the account pages show an honest
# "not set up yet" notice instead of breaking.
#
# Get them from your Supabase project → Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER ONLY. Bypasses row level security — never expose it to the browser
# and never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
